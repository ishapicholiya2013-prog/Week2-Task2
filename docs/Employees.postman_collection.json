{
  "info": {
    "name": "Northstar People CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3002"
    },
    {
      "key": "employeeId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Create",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/employees",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Isha\",\n  \"department\": \"Engineering\",\n  \"role\": \"Web Developer\",\n  \"salary\": 600000,\n  \"joinDate\": \"2026-10-01\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Created', () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set('employeeId', pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/employees"
      }
    },
    {
      "name": "Detail",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/employees/{{employeeId}}"
      }
    },
    {
      "name": "Update",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/employees/{{employeeId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Isha\",\n  \"department\": \"Engineering\",\n  \"role\": \"Frontend Developer\",\n  \"salary\": 600000,\n  \"joinDate\": \"2026-10-01\"\n}"
        }
      }
    },
    {
      "name": "Delete",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/api/employees/{{employeeId}}"
      }
    }
  ]
}
